{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-main",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/v1/*", "/git/*", "/cli/*", "/api/*", "/runs/*", "/bench/solutions/*", "/debug/*"] },
  "containers": [
    {
      "class_name": "Workcell",
      "scheduling_policy": "durable_object",
      "images": {
        "workcell": { "dockerfile": "../../containers/workcell/Dockerfile", "build_context": "../.." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ORG", "class_name": "OrgDO" },
      { "name": "REPO", "class_name": "RepoDO" },
      { "name": "REPO_AGENT", "class_name": "RepoAgentDO" },
      { "name": "COORDINATOR", "class_name": "CoordinatorDO" },
      { "name": "WORKCELL", "class_name": "Workcell" },
      { "name": "AGENT", "class_name": "SwarmAgentDO" },
      { "name": "RUN", "class_name": "RunDO" }
    ]
  },
  "exports": {
    "OrgDO": { "type": "durable-object", "storage": "sqlite" },
    "RepoDO": { "type": "durable-object", "storage": "sqlite" },
    "RepoAgentDO": { "type": "durable-object", "storage": "sqlite" },
    "CoordinatorDO": { "type": "durable-object", "storage": "sqlite" },
    "Workcell": { "type": "durable-object", "storage": "sqlite" },
    "SwarmAgentDO": { "type": "durable-object", "storage": "sqlite" },
    "RunDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Cloudflare Artifacts hosts every repository (open beta, Workers Paid). It has no local
  // simulator: under `wrangler dev` it is the remote service. Without it, set GIT_REMOTE_BASE.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "live-main" }],
  // Deployed behind Cloudflare Access: ACCESS_TEAM_DOMAIN and ACCESS_AUD come from the Access
  // application on the workers.dev route (without them the API answers 503); /git/* has its own
  // Bypass application and uses git tokens. Secret: LIVEMAIN_MASTER_KEY (wrangler secret put).
  "vars": {
    "WORKER_MODEL": "claude-haiku-4-5",
    "LIVEMAIN_ORG": "demo",
    "LIVEMAIN_REQUIRE_ACCESS": "1",
    "ACCESS_TEAM_DOMAIN": "damp-sea-b9bc.cloudflareaccess.com",
    "ACCESS_AUD": "aa360e937628a75dba60d4d7b5dff9f2ff6313b12c02b8d9e4a02173ddefc315"
  },
  "observability": { "enabled": true }
}
