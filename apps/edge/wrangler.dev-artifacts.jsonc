// wrangler.dev.jsonc with real Cloudflare Artifacts as the git host: the Worker and Durable
// Objects run locally, repositories live in Artifacts, and the local workcells and integrator
// clone from and push to it over the internet. Needs Workers Paid and `wrangler login`.
//   pnpm livemain up --workcells 2
//   npx wrangler dev -c wrangler.dev-artifacts.jsonc --port 8788 --persist-to .wrangler/state-artifacts
// (separate local state: repos recorded under wrangler.dev.jsonc live on the local git server)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-main",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/v1/*", "/git/*", "/cli/*", "/api/*", "/runs/*", "/bench/solutions/*", "/debug/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ORG", "class_name": "OrgDO" },
      { "name": "REPO", "class_name": "RepoDO" },
      { "name": "REPO_AGENT", "class_name": "RepoAgentDO" },
      { "name": "COORDINATOR", "class_name": "CoordinatorDO" },
      { "name": "WORKCELL", "class_name": "Workcell" },
      { "name": "AGENT", "class_name": "SwarmAgentDO" },
      { "name": "RUN", "class_name": "RunDO" }
    ]
  },
  "exports": {
    "OrgDO": { "type": "durable-object", "storage": "sqlite" },
    "RepoDO": { "type": "durable-object", "storage": "sqlite" },
    "RepoAgentDO": { "type": "durable-object", "storage": "sqlite" },
    "CoordinatorDO": { "type": "durable-object", "storage": "sqlite" },
    "Workcell": { "type": "durable-object", "storage": "sqlite" },
    "SwarmAgentDO": { "type": "durable-object", "storage": "sqlite" },
    "RunDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "WORKER_MODEL": "claude-haiku-4-5",
    "LIVEMAIN_ORG": "demo",
    "INTEGRATOR_URL": "http://localhost:18091",
    "WORKCELL_URLS": "http://localhost:18100,http://localhost:18101"
  },
  // Artifacts has no local simulator: this is the real service on your account (Workers Paid).
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "live-main-dev", "remote": true }],
  "observability": { "enabled": true }
}
