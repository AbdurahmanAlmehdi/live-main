// Coordinator-only config: no containers, no Artifacts. Used for synthetic stress tests
// (POST /api/synth-runs) and for developing the Durable Objects without Docker.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-main-coordinator-only",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": ["/bench/solutions/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "CoordinatorDO" },
      { "name": "WORKCELL", "class_name": "Workcell" },
      { "name": "AGENT", "class_name": "SwarmAgentDO" },
      { "name": "RUN", "class_name": "RunDO" }
    ]
  },
  "exports": {
    "CoordinatorDO": { "type": "durable-object", "storage": "sqlite" },
    "Workcell": { "type": "durable-object", "storage": "sqlite" },
    "SwarmAgentDO": { "type": "durable-object", "storage": "sqlite" },
    "RunDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": { "WORKER_MODEL": "claude-haiku-4-5" },
  "observability": { "enabled": true }
}
